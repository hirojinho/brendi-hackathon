{
  "name": "study-assistant-desktop",
  "version": "1.0.0",
  "description": "macOS Desktop Overlay App for Study Assistant",
  "main": "dist/main/main.js",
  "type": "module",
  "scripts": {
    "build:web": "cd ../web && ELECTRON_BUILD=true npm run build",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && mv dist/main/preload.js dist/main/preload.cjs && node scripts/copyOverlay.js",
    "build": "npm run build:web && npm run build:renderer && npm run build:electron",
    "dev": "npm run build:web && npm run build:renderer && concurrently -k \"tsc -w -p tsconfig.main.json\" \"tsc -w -p tsconfig.preload.json\" \"wait-on dist/main/main.js && electron .\"",
    "start": "npm run build && electron .",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@langchain/openai": "^0.0.14",
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "electron-store": "^10.1.0",
    "express": "^4.18.3",
    "get-port": "^7.0.0",
    "katex": "^0.16.25",
    "langchain": "^0.1.25",
    "marked": "^16.4.1",
    "multer": "^1.4.5-lts.2",
    "node-fetch": "^3.3.2",
    "openai": "^4.28.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^2.16.105",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.11.24",
    "@types/node-fetch": "^2.6.12",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-rebuild": "^3.2.9",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "wait-on": "^7.2.0"
  }
}
